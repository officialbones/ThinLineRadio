# County Pulse transcription API
PULSE_API_BASE=https://data.countypulsenetwork.com/api/transcriptions
PULSE_SYSTEM_IDS=11,7,56,57,58,59,60,61
PULSE_POLL_SECONDS=300

# ThinLine Postgres (read-only recommended) — usually on the SDR / ThinLine host
POSTGRES_DSN=postgresql://user:password@192.168.1.50:5432/thinline

# Scanner considered quiet if no call newer than this (seconds)
CALL_STALE_SECONDS=120
HEALTH_POLL_SECONDS=5

# Other computer (SDRTrunk / ThinLine / Postgres host)
REMOTE_HOST=192.168.1.50
REMOTE_TCP_PORT=5432
TLR_HEALTH_URL=http://192.168.1.50:3000/api/health/live
TLR_HEALTH_USER=
TLR_HEALTH_PASSWORD=

# Google Maps (Geocoding + Maps Static + Street View Static)
GOOGLE_MAPS_API_KEY=

# Default region bias for geocoding (Indiana counties)
GEOCODE_REGION=us
GEOCODE_COMPONENTS=administrative_area:IN|country:US

# Publer — https://publer.com/docs
PUBLER_API_KEY=
PUBLER_WORKSPACE_ID=
PUBLER_POLL_SECONDS=120

# Address overlay
ADDRESS_OVERLAY_SECONDS=25
ADDRESS_DEFAULT_CITY=

# Display
WINDOW_WIDTH=1080
WINDOW_HEIGHT=1920
